# Copy this file to .env and fill in the values before deploying.

# Required: change this to a long random string in production
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pixelcraft-change-this-in-production

# Optional: port exposed on the host (default: 80)
PORT=80

# Optional: keeps Docker Compose container and volume names stable
COMPOSE_PROJECT_NAME=pixelcraft

# Optional: enables AI enhancement on the admin preview screen
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_MODERATION=low
OPENAI_GRID_MODEL=gpt-4.1-mini
OPENAI_GRID_MAX_OUTPUT_TOKENS=60000
OPENAI_REQUEST_TIMEOUT=45
